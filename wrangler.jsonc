{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vap-chat",
  "compatibility_date": "2026-09-25",
  "main": "./src/worker.js",

  "assets": {
  "not_found_handling": "single-page-application",
  "run_worker_first": ["/api/*"]
},

  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_ROOM",
        "class_name": "ChatRoom"
      }
    ]
  },

  "exports": {
    "ChatRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}